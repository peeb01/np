{
  "name": "vscode-np",
  "displayName": "np-lang support",
  "description": "Syntax highlighting and language configuration for the np programming language.",
  "version": "0.1.0",
  "publisher": "peeb01",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:np",
    "onLanguage:np-expected"
  ],
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "np",
        "aliases": [
          "np",
          "np-lang"
        ],
        "extensions": [
          ".np"
        ],
        "filenames": [
          "np.req",
          "np.req.log",
          "np"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./image/NP.png",
          "dark": "./image/NP.png"
        }
      },
      {
        "id": "np-expected",
        "aliases": [
          "NP Expected Result",
          "np-expected"
        ],
        "extensions": [
          ".np.expected"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./image/NP-expected.png",
          "dark": "./image/NP-expected.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "np",
        "scopeName": "source.np",
        "path": "./syntaxes/np.tmLanguage.json"
      },
      {
        "language": "np-expected",
        "scopeName": "source.np",
        "path": "./syntaxes/np.tmLanguage.json"
      }
    ]
  }
}
