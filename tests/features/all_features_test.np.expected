=== 1. Testing Element-wise Array Arithmetic & Scalar Broadcasting ===
A =
[1, 2, 3]
B =
[10, 20, 30]
A + B =
[11, 22, 33]
A - B =
[-9, -18, -27]
A * B =
[10, 40, 90]
B / A =
[10, 10, 10]
B % A =
[0, 0, 0]
A ^ B =
[1, 1048576, [PTR]]

--- Scalar Broadcasting ---
A + 10 =
[11, 12, 13]
10 - A =
[9, 8, 7]
A * 5 =
[5, 10, 15]
A ^ 2 =
[1, 4, 9]

