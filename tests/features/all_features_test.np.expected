=== 4. Testing Vectorized Slicing ===
slice_arr =
[10, 20, 30, 40, 50]
slice_arr[1:4] =
[20, 30, 40]
slice_arr[:3] =
[10, 20, 30]
slice_arr[2:] =
[30, 40, 50]
slice_arr[:] =
[10, 20, 30, 40, 50]
slice_str =
abcdefg
slice_str[1:4] =
bcd
slice_str[:3] =
abc
slice_str[2:] =
cdefg
slice_str[:] =
abcdefg