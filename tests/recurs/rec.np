import time

func rec(int n) -> int:
    if n <= 1:
        return n
    return n + rec(n - 1)

func main():
    int n = 500000000   # 500m

    float t_start = time.now()
    int result = rec(n)
    float t_end = time.now()

    float duration = t_end - t_start
    float duration_ms = duration * 1000.0

    print("Result: " + result)
    print("Duration (seconds) " + duration)
    print("Duration (ms) " + duration_ms)
